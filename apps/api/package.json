{
  "name": "@hotel/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "build": "prisma generate && vite build",
    "start": "node dist/main.js",
    "db:migrate": "tsx prisma/scripts/migrate.ts",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@date-fns/tz": "catalog:",
    "@hotel/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:"
  }
}
