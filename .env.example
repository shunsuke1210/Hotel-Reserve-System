# 環境設定のひな形。リポジトリの最上位で .env にコピーして使う（.env は Git に入れない）。
#   cp .env.example .env
# ここにある値は、この PC の中だけで使う開発用の仮の値。本番のサーバーでは必ず別の値にする。
#
# API（apps/api/src/shared/config/app-config.ts）の読み込みの順序（後のものが優先）：
#   .env → .env.{APP_ENV}（例：.env.test・.env.production）→ 環境変数
# APP_ENV（development・test・production。既定は development）は環境変数で指定する。

# --- データベースのコンテナ（docker-compose.yml の postgres・postgres-test）---
# テーブルの所有者（マイグレーション用の利用者）。パスワードを変えるときは、下の
# MIGRATION_DATABASE_URL・TEST_MIGRATION_DATABASE_URL のパスワードも同じ値にする
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_dev_password
POSTGRES_DB=hotel
POSTGRES_TEST_DB=hotel_test
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- API ---
# データベースの利用者は2つに分ける（操作履歴を API から変更・削除できないようにするため。要件 18.2）
#   アプリ用（DATABASE_URL・TEST_DATABASE_URL）：API が使う。テーブルの所有者ではなく、操作履歴の UPDATE・DELETE の権限がない。
#     この利用者（とパスワード）は、pnpm db:migrate と結合テストの準備が、ここに書いた値で作る
#   マイグレーション用（MIGRATION_DATABASE_URL・TEST_MIGRATION_DATABASE_URL）：テーブルの所有者（上の POSTGRES_USER）。
#     マイグレーションと結合テストの準備だけに使う（API の実行には要らない）
#
# 開発用のデータベース（APP_ENV が development・production のときに使う）
DATABASE_URL=postgresql://hotel_api:hotel_api_dev_password@127.0.0.1:5432/hotel
MIGRATION_DATABASE_URL=postgresql://hotel:hotel_dev_password@127.0.0.1:5432/hotel
# 結合テスト用のデータベース（APP_ENV=test のときに使う。DATABASE_URL とは別のデータベースにする）。
# 結合テストは、このサーバーにテストのファイルごとの空のデータベースを作って使う
TEST_DATABASE_URL=postgresql://hotel_api:hotel_api_dev_password@127.0.0.1:5433/hotel_test
TEST_MIGRATION_DATABASE_URL=postgresql://hotel:hotel_dev_password@127.0.0.1:5433/hotel_test
